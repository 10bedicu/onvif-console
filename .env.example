# Copy this file to `.env` and fill in your camera's details.
# `.env` is gitignored so credentials stay out of version control.
# Real environment variables (e.g. `export ONVIF_HOST=...`) override .env values.

ONVIF_HOST=192.168.1.100   # camera IP or hostname
ONVIF_PORT=80              # ONVIF service port (often 80, 8000, or 2020)
ONVIF_USER=admin
ONVIF_PASS=changeme
